# Installation secret the two agents present to the OpenMuse app's /api/agent routes.
# scripts/setup uploads it as a project secret; never put a value in this file.
OPENMUSE_AGENT_SECRET=

# Kernel API key the topic worker presents to Kernel's hosted MCP server for
# browser access. Use a project-scoped key (see docs/configuration.md). Set it
# with `opencomputer secrets set KERNEL_API_KEY`; never put a value in this file.
KERNEL_API_KEY=
